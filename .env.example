# MetaLens needs no environment variables to run. Everything below is optional
# and only used by the deployment scripts.
#
# Copy to `.env.local` (git-ignored) and fill in what you need.

# Base path of the deployed site: "/" for a root domain, "/metalens/" for a
# GitHub Pages project page.
VITE_BASE_PATH=/

# Optional URL of a self-hosted fetch endpoint (see worker/). When empty, the
# "From URL" mode relies on the target site's CORS headers and explains itself.
# You can also set this at runtime in the app: Settings -> Fetch endpoint.
VITE_FETCH_ENDPOINT=

# --- deployment only (never committed) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# PAGES_PROJECT=metalens
